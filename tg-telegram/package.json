{
  "name": "com.sidiusz.telegram-web",
  "productName": "Telegram Web Desktop",
  "version": "1.3.0",
  "description": "",
  "type": "commonjs",
  "main": "main.cjs",
  "scripts": {
    "dev": "electron .",
    "build": "electron-builder --config.electronDist=node_modules/electron/dist",
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "test:smoke": "node scripts/smoke.cjs",
    "build:release": "node scripts/release-build.cjs"
  },
  "license": "MIT",
  "build": {
    "asar": true,
    "electronDist": "node_modules/electron/dist",
    "files": [
      "main.cjs",
      "electron/**/*",
      "build/installer.nsh",
      "!**/.cdp*.mjs",
      "!**/.devlog.txt",
      "!**/out.log",
      "!**/err.log",
      "!**/*.map"
    ],
    "protocols": [
      {
        "name": "Telegram URL",
        "schemes": [
          "tg"
        ]
      }
    ],
    "nsis": {
      "include": "build/installer.nsh"
    },
    "electronFuses": {
      "runAsNode": false,
      "enableCookieEncryption": true,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true,
      "grantFileProtocolExtraPrivileges": false
    }
  },
  "dependencies": {
    "adm-zip": "^0.6.1",
    "electron-store": "^11.0.2",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "electron": "^41.10.7",
    "electron-builder": "^26.15.3"
  }
}
