{
  "name": "com.sidiusz.telegram-web",
  "productName": "Telegram Web Desktop", 
  "version": "1.2.6",
  "description": "",
  "type": "commonjs",
  "main": "main.cjs",
  "scripts": {
    "dev": "electron .",
    "build": "electron-builder",
    "start": "electron ."
  },
  "license": "MIT",
  "build": {
    "files": [
      "**/*",
      "!.cdp.mjs"
    ],
    "protocols": [
      {
        "name": "Telegram URL",
        "schemes": [
          "tg"
        ]
      }
    ],
    "nsis": {
      "include": "build/installer.nsh"
    }
  },
  "dependencies": {
    "adm-zip": "^0.5.10",
    "electron-store": "^11.0.2"
  },
  "devDependencies": {
    "electron": "^40.6.1",
    "electron-builder": "^26.8.1"
  }
}